<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="Checkers.MainPage">

    <Grid ColumnDefinitions="1*,3*" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top row: Server + Client side by side -->
        <Grid Grid.Row="0" Grid.Column ="0" RowDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">

            <!-- CONNECT TO SERVER PANEL -->
            <Frame Grid.Row ="0" Padding="10" BorderColor="Gray">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Connect to Server" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="Host/IP:" VerticalOptions="Center"/>
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="ClientHostEntry" Text="192.168.0.153"/>
                    </Grid>

                    <HorizontalStackLayout Spacing="6">
                        <Button x:Name="ConnectButton" Text="Connect" Clicked="OnJoinServer" />
                        <Button x:Name="HostServer" Text="Host Server" Clicked="OnHostServer" />
                        <Button x:Name="DisconnectButton" Text="Disconnect" IsEnabled="False" Clicked="OnDisconnect" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Button x:Name="RestartButton" Text="Restart" IsEnabled="False" Clicked="OnRestartGame" />
                    </HorizontalStackLayout>

                    <Label x:Name="ClientStatusLabel" Text="Not connected." FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Section label -->
            <Label Grid.Row="1" Text="Log" FontAttributes="Bold" Margin="4,6,4,0"/>

            <!-- LOG -->
            <Frame Grid.Row="2" Padding="4" BorderColor="Gray">
                <CollectionView x:Name="LogCollectionView" ItemsSource="{Binding LogEntries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" Padding="4,2" FontSize="13"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- MESSAGE INPUT -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Entry Grid.Column="0" x:Name="MessageEntry" Placeholder="Type a message..."/>
                <Button Grid.Column="1" Text="Send"/>
            </Grid>
            
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <skia:SKCanvasView  
                x:Name="canvas"
                BackgroundColor="Red"
                HeightRequest="640"
                WidthRequest="640"
                EnableTouchEvents="true"
                Touch="OnCanvasTouch"
                PaintSurface="OnCanvasViewPaintSurface" />

            <Label x:Name="CoordinateLabel" 
               Grid.Row="1" 
               Text="X: 0, Y: 0" 
               HorizontalOptions="Center"
               FontSize="14"
               Padding="10" />
        </Grid>
        
    </Grid>

</ContentPage>
